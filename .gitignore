data/
storage/
backend/*.db
backend/*.db-shm
backend/*.db-wal
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# ===== 前端 =====
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.tsbuildinfo
frontend/vite.config.ts.timestamp-*
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm-cache/

# ===== 编辑器与系统 =====
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.sw?

# ===== 日志与临时文件 =====
*.log
logs/
*.tmp

.env.local
.env.*.local
*.env
!.env.example

# ===== Python 虚拟环境 =====
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== 运行期数据 =====
